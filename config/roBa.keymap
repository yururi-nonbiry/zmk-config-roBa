#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/* ========================================================================== */
/* 1. 先にルートノード（/）を開いて、zip_temp_layer の中身をしっかり定義する   */
/* ========================================================================== */
/ {
    zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <0>;
    };
};

/* ========================================================================== */
/* 2. 定義が完了した後に、それらを使った設定（&）を記述する                  */
/* ========================================================================== */
&trackball { scroll-layers = <5>; };

&trackball_listener { input-processors = <&zip_temp_layer 4 10000>; };

&zip_temp_layer { excluded-positions = <7 18 19 20>; };

/* ========================================================================== */
/* 3. 残りの combos などの定義を続ける（ここもルートノードの中身です）        */
/* ========================================================================== */
/ {
    combos {
        compatible = "zmk,combos";
        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp Q           &kp W         &kp E         &kp R        &kp T                                                     &kp Y   &kp U      &kp I    &kp O                    &kp P
      &mt LCTRL A           &kp S         &kp D         &kp F        &kp G  &kp NUMBER_1                   &kp NUMBER_3        &kp H   &kp J      &kp K    &kp L      &mt RCTRL LS(SLASH)
 &mt LEFT_SHIFT Z           &kp X         &kp C         &kp V        &kp B  &kp NUMBER_2                   &kp NUMBER_4        &kp N   &kp M  &kp COMMA  &kp DOT          &mt RSHFT MINUS
        &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 SPACE       &kp TAB                  &kp BACKSPACE  &lt 1 ENTER                              &kp LS(INTERNATIONAL_1)                     &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
 &kp F1   &kp F2   &kp F3   &kp F4  &trans                                            &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp LS(SINGLE_QUOTE)      &kp SLASH
 &kp F5   &kp F6   &kp F7   &kp F8  &trans  &trans                  &kp LS(NUMBER_4)  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6     &kp LS(SEMICOLON)      &kp MINUS
 &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans                  &kp LS(NUMBER_5)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3          &kp NUMBER_0  &kp LS(MINUS)
 &trans   &trans   &trans   &trans  &trans  &trans                            &trans        &trans                                                       &kp PERIOD
            >;
        };

        NUM {
            bindings = <
        &kp ESC    &kp UP_ARROW       &kp INSERT  &kp SCROLLLOCK    &kp C_PAUSE                                                &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)         &kp LS(NUMBER_3)
 &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW        &kp HOME      &kp PG_UP  &trans                  &kp LS(LEFT_BRACKET)  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)      &kp RIGHT_BRACKET      &kp BACKSLASH  &kp LS(INTERNATIONAL_3)
         &trans          &trans           &trans         &kp END  &kp PAGE_DOWN  &trans                      &kp LEFT_BRACKET     &kp SEMICOLON  &kp SINGLE_QUOTE       &kp LS(NUMBER_8)   &kp LS(NUMBER_9)      &kp INTERNATIONAL_3
      &kp GRAVE          &trans           &trans          &trans         &trans  &trans                            &kp DELETE            &trans                                                                        &kp LS(EQUAL)                                                                  &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &trans  &trans  &trans  &trans  &trans
&bt BT_CLR    &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mo 5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
