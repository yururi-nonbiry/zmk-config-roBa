#include "roBa.dtsi"
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    /* Adds momentum to SCROLL-layer scrolling: a fast flick keeps scrolling and
     * decays after the finger lifts, but a slow drag stops immediately. Sits on
     * the mapped single-finger movement below (raw sensor counts), not on the
     * native two-finger gesture's pre-quantized wheel output, so the module's
     * default `start`/`move` (tuned for raw counts) are left as-is.
     * `stop = 1` follows the module's own guidance for a 1:1 scale/scale-div
     * (no downstream scaler on this chain) - keeps the tail above ~5Hz so it
     * doesn't end in visible discrete "clicks". `layer = 5` makes the module
     * reset its internal state the instant the SCROLL layer turns off, so
     * leaving mid-coast can't leave stale state that silently eats the start
     * of the next session.
     * axis = 0 treats scroll+hscroll as one vector, matching diagonal scrolling.
     * This node must stay on the R (central) side only - the module fails the
     * build if it's ever enabled on a peripheral. */
    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <0>;
        stop = <1>;
        layer = <5>;
    };

    /* Same idea, but for the trackpad's native two-finger scroll gesture. That
     * gesture's driver accumulates raw movement and divides by 32 before
     * emitting a wheel event (drivers/input/iqs5xx.c), so each event's value is
     * almost always 1 (occasionally 2-3 on a hard flick) - nowhere near the
     * ~40+ raw-count magnitude the module's defaults assume. `start`/`move`/
     * `min-events`/`release`/`gesture-timeout` are scaled down to match this
     * much coarser, sparser event stream; everything else (decay, friction,
     * scale) is left at defaults since those are ratio-based, not magnitude-
     * based, and already come out fixed-point-smooth regardless of how coarse
     * the raw input is. Untested on hardware - expect to retune. */
    scroll_inertia_native: scroll_inertia_native {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;
        axis = <0>;
        start = <2>;
        move = <6>;
        min-events = <5>;
        release = <48>;
        gesture-timeout = <150>;
        stop = <1>;
    };
};

&trackpad_listener {
    status = "okay";
    device = <&trackpad>;
    input-processors = <&zip_temp_layer 4 10000 &scroll_inertia_native>;

    /* While the SCROLL layer (5) is held, map the trackpad's single-finger raw
     * movement to wheel/hwheel events instead of cursor movement, then add
     * inertia to that. This restores the old trackball's `scroll-layers = <5>`
     * behavior, which the IQS5xx driver has no equivalent devicetree property
     * for - so it's rebuilt here as a layer-specific input-processor override. */
    scroller {
        layers = <5>;
        input-processors = <&zip_xy_to_scroll_mapper &scroll_inertia>;
    };
};

/* i2c0 and spi0 are the same nRF52840 peripheral instance (0x40003000) -
 * only one may be enabled at a time. The trackball's SPI0 pins (P0.05,
 * P0.04) are reused here as I2C0 SCL/SDA since SPI0 is no longer used. */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 5)>,
                <NRF_PSEL(TWIM_SDA, 0, 4)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 5)>,
                <NRF_PSEL(TWIM_SDA, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    /* TPS43 (Azoteq IQS572) trackpad, I2C mode - the module's only interface.
     * reg 0x74 is the IQS5xx family's fixed 7-bit I2C address.
     * TODO: reset-gpios/rdy-gpios reuse the trackball's old CS (P0.09) and
     * IRQ (P0.02) pins as placeholders - confirm against the actual TPS43
     * FFC wiring (J1: 1=RDY, 2=SDA, 3=GND, 4=VDDHI, 5=SCL, 6=NRST). */
    trackpad: trackpad@74 {
        status = "okay";
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
        rdy-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

        /* Sensor's raw axes are rotated 90 degrees from the module's mounted
         * orientation (physically rotating the pad 90 deg clockwise fixes it) -
         * compensate in software instead by swapping x/y. */
        switch-xy;

        one-finger-tap;
        press-and-hold;
        two-finger-tap;
        scroll;
    };
};
